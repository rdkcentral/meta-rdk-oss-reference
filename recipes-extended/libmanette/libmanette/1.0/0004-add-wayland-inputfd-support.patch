diff --git a/src/manette-evdev-backend.c b/src/manette-evdev-backend.c
index 403a345..120dc5a 100644
--- a/src/manette-evdev-backend.c
+++ b/src/manette-evdev-backend.c
@@ -21,6 +21,7 @@
 
 #include "manette-evdev-backend-private.h"
 
+#include <errno.h>
 #include <fcntl.h>
 #include <libevdev/libevdev.h>
 #include <linux/input.h>
@@ -41,6 +42,7 @@ struct _ManetteEvdevBackend
   char *filename;
 
   int fd;
+  gboolean has_external_fd;
   guint event_source_id;
   struct libevdev *evdev_device;
 
@@ -464,11 +466,15 @@ manette_evdev_backend_initialize (ManetteBackend *backend)
   int axes_number;
   guint i;
 
-  self->fd = open (self->filename, O_RDWR | O_NONBLOCK, (mode_t) 0);
-  if (self->fd < 0) {
-    g_debug ("Failed to open %s: %s", self->filename, strerror (errno));
+  /* When the fd was provided externally (e.g. handed over by the wayland
+   * inputfd protocol) it is already open; otherwise open the device node. */
+  if (!self->has_external_fd) {
+    self->fd = open (self->filename, O_RDWR | O_NONBLOCK, (mode_t) 0);
+    if (self->fd < 0) {
+      g_debug ("Failed to open %s: %s", self->filename, strerror (errno));
 
-    return FALSE;
+      return FALSE;
+    }
   }
 
   self->evdev_device = libevdev_new ();
@@ -699,3 +705,89 @@ manette_evdev_backend_new (const char *filename)
 
   return MANETTE_BACKEND (self);
 }
+
+/*
+ * manette_evdev_backend_new_for_fd:
+ * @fd: an already-open evdev file descriptor
+ *
+ * Creates an evdev backend that wraps an already-open fd instead of opening a
+ * device node. Used by the wayland inputfd path, where the compositor hands
+ * over the fd. The backend takes ownership of @fd and closes it on finalize.
+ *
+ * Returns: (transfer full): a new backend
+ */
+ManetteBackend *
+manette_evdev_backend_new_for_fd (int fd)
+{
+  ManetteEvdevBackend *self = g_object_new (MANETTE_TYPE_EVDEV_BACKEND, NULL);
+
+  self->fd = fd;
+  self->has_external_fd = TRUE;
+
+  return MANETTE_BACKEND (self);
+}
+
+/*
+ * manette_evdev_backend_change_fd:
+ * @backend: a #ManetteEvdevBackend
+ * @fd: the new evdev fd to use
+ *
+ * Replaces the fd of an already-initialized evdev backend with a new one,
+ * closing the old fd. Used when the wayland inputfd protocol hands over a fresh
+ * fd for the same logical device (e.g. after a focus-out/focus-in cycle).
+ */
+void
+manette_evdev_backend_change_fd (ManetteBackend *backend,
+                                 int             fd)
+{
+  ManetteEvdevBackend *self = MANETTE_EVDEV_BACKEND (backend);
+  g_autoptr (GIOChannel) channel = NULL;
+  struct input_event evdev_event;
+
+  g_return_if_fail (MANETTE_IS_EVDEV_BACKEND (self));
+  g_return_if_fail (fd >= 0);
+
+  g_clear_handle_id (&self->event_source_id, g_source_remove);
+  close (self->fd);
+  self->fd = fd;
+
+  /* Point libevdev at the new fd and drain any pending re-sync events. */
+  libevdev_change_fd (self->evdev_device, fd);
+  libevdev_next_event (self->evdev_device,
+                       (guint) LIBEVDEV_READ_FLAG_FORCE_SYNC,
+                       &evdev_event);
+  while (libevdev_next_event (self->evdev_device,
+                              (guint) LIBEVDEV_READ_FLAG_SYNC,
+                              &evdev_event) == LIBEVDEV_READ_STATUS_SYNC)
+    ; /* drain */
+
+  channel = g_io_channel_unix_new (self->fd);
+  self->event_source_id = g_io_add_watch (channel, G_IO_IN | G_IO_HUP | G_IO_ERR,
+                                          (GIOFunc) poll_events, self);
+}
+
+/*
+ * manette_evdev_backend_is_revoked:
+ * @backend: a #ManetteEvdevBackend
+ *
+ * Returns whether the evdev fd has been revoked (EVIOCREVOKE). A revoked fd
+ * fails every ioctl with ENODEV.
+ *
+ * Returns: %TRUE if the device has been revoked
+ */
+gboolean
+manette_evdev_backend_is_revoked (ManetteBackend *backend)
+{
+  ManetteEvdevBackend *self = MANETTE_EVDEV_BACKEND (backend);
+  int driver_version;
+
+  g_return_val_if_fail (MANETTE_IS_EVDEV_BACKEND (self), TRUE);
+
+  if (self->fd < 0)
+    return TRUE;
+
+  if (ioctl (self->fd, EVIOCGVERSION, &driver_version) == -1)
+    return errno == ENODEV;
+
+  return FALSE;
+}
diff --git a/src/manette-monitor.c b/src/manette-monitor.c
index f73328a..c818868 100644
--- a/src/manette-monitor.c
+++ b/src/manette-monitor.c
@@ -33,6 +33,12 @@
 #include "manette-hid-backend-private.h"
 #include "manette-mapping-manager-private.h"
 
+#ifdef WAYLAND_INPUTFD_ENABLED
+ #include <fcntl.h>
+ #include <unistd.h>
+ #include "manette-wayland-inputfd-private.h"
+#endif
+
 #define DEV_DIRECTORY "/dev"
 #define INPUT_DIRECTORY DEV_DIRECTORY "/input"
 
@@ -51,6 +57,9 @@ struct _ManetteMonitor {
   ManetteMappingManager *mapping_manager;
 #ifdef GUDEV_ENABLED
   GUdevClient *client;
+#endif
+#ifdef WAYLAND_INPUTFD_ENABLED
+  ManetteWaylandInputFd *wayland_inputfd;
 #endif
   GFileMonitor *dev_monitor;
   GFileMonitor *input_monitor;
@@ -156,6 +165,118 @@ remove_device (ManetteMonitor *self,
   g_object_unref (device);
 }
 
+#ifdef WAYLAND_INPUTFD_ENABLED
+
+/* The wayland inputfd protocol delivers an already-open evdev fd (the
+ * compositor owns the device and lends the fd while the client is focused),
+ * keyed by a per-device uuid rather than a /dev/input path. */
+static void
+add_device_for_fd (ManetteMonitor *self,
+                   const char     *uuid,
+                   int             fd)
+{
+  g_autoptr (ManetteDevice) device = NULL;
+  g_autoptr (ManetteBackend) backend = NULL;
+  g_autoptr (GError) error = NULL;
+
+  g_assert (self != NULL);
+  g_assert (uuid != NULL);
+
+  if (g_hash_table_contains (self->devices, uuid)) {
+    close (fd);
+    return;
+  }
+
+  backend = manette_evdev_backend_new_for_fd (fd);
+  if (!manette_backend_initialize (backend))
+    return;
+
+  device = manette_device_new (g_steal_pointer (&backend), &error);
+  if (G_UNLIKELY (error != NULL)) {
+    g_debug ("Failed to create device: %s", error->message);
+
+    return;
+  }
+
+  if (manette_device_supports_mapping (device))
+    load_mapping (self, device);
+
+  g_hash_table_insert (self->devices,
+                       g_strdup (uuid),
+                       g_object_ref (device));
+  g_signal_emit (self, signals[SIG_DEVICE_CONNECTED], 0, device);
+}
+
+static void
+wayland_inputfd_device_focus_in_cb (ManetteWaylandInputFd *sender,
+                                    const char            *uuid,
+                                    int                    fd,
+                                    ManetteMonitor        *self)
+{
+  int dup_fd;
+  int flags;
+  ManetteDevice *device;
+
+  /* The caller owns @fd and closes it after this callback, so dup it. */
+  dup_fd = fcntl (fd, F_DUPFD_CLOEXEC, 3);
+  if (dup_fd < 0)
+    return;
+
+  flags = fcntl (dup_fd, F_GETFL);
+  if (flags >= 0)
+    fcntl (dup_fd, F_SETFL, flags | O_NONBLOCK);
+
+  device = g_hash_table_lookup (self->devices, uuid);
+  if (device == NULL) {
+    add_device_for_fd (self, uuid, dup_fd);
+
+    /* If the fd was already revoked we may not have read all the device info;
+     * drop it and wait for the next focus_in with a fresh fd. */
+    device = g_hash_table_lookup (self->devices, uuid);
+    if (device != NULL &&
+        manette_evdev_backend_is_revoked (manette_device_get_backend (device)))
+      remove_device (self, uuid);
+  } else {
+    manette_evdev_backend_change_fd (manette_device_get_backend (device), dup_fd);
+  }
+}
+
+static void
+wayland_inputfd_device_removed_cb (ManetteWaylandInputFd *sender,
+                                   const char            *uuid,
+                                   ManetteMonitor        *self)
+{
+  remove_device (self, uuid);
+}
+
+static void
+init_wayland_backend (ManetteMonitor *self)
+{
+  g_autoptr (GError) error = NULL;
+
+  self->wayland_inputfd = manette_wayland_inputfd_new (&error);
+  if (G_UNLIKELY (error != NULL)) {
+    g_debug ("%s", error->message);
+
+    return;
+  }
+
+  /* We only learn about a device's evdev fd on focus_in (a ManetteDevice wraps
+   * an fd), so the 'device-added' / 'device-focus-out' signals are ignored. */
+  g_signal_connect_object (self->wayland_inputfd,
+                           "device-focus-in",
+                           (GCallback) wayland_inputfd_device_focus_in_cb,
+                           self,
+                           0);
+  g_signal_connect_object (self->wayland_inputfd,
+                           "device-removed",
+                           (GCallback) wayland_inputfd_device_removed_cb,
+                           self,
+                           0);
+}
+
+#endif /* WAYLAND_INPUTFD_ENABLED */
+
 #ifdef GUDEV_ENABLED
 
 static void
@@ -523,6 +644,14 @@ manette_monitor_init (ManetteMonitor *self)
     coldplug_gudev_devices (self);
 #endif
   }
+
+#ifdef WAYLAND_INPUTFD_ENABLED
+  /* Also listen for devices handed over by the compositor. On a sandboxed
+   * client the file/gudev backend above finds nothing (no /dev/input access)
+   * and this is the only source; the protocol replays existing devices on
+   * connect, so no coldplug is needed here. */
+  init_wayland_backend (self);
+#endif
 }
 
 static void
@@ -533,6 +662,9 @@ manette_monitor_finalize (GObject *object)
 #ifdef GUDEV_ENABLED
   g_clear_object (&self->client);
 #endif
+#ifdef WAYLAND_INPUTFD_ENABLED
+  g_clear_object (&self->wayland_inputfd);
+#endif
 
   g_clear_object (&self->dev_monitor);
   g_clear_object (&self->input_monitor);
