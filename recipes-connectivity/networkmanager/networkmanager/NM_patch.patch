diff --git a/src/core/nm-policy.c b/src/core/nm-policy.c
--- a/src/core/nm-policy.c
+++ b/src/core/nm-policy.c
@@ -2868,7 +2868,25 @@ dispose(GObject *object)
     NMPolicy        *self = NM_POLICY(object);
     NMPolicyPrivate *priv = NM_POLICY_GET_PRIVATE(self);

-    nm_assert(!c_list_is_empty(&priv->policy_auto_activate_lst_head));
+    /* The auto-activate list may legitimately be empty during shutdown.
+     * The original assertion caused NetworkManager to abort if the list
+     * was empty. Instead, clean up the list safely regardless of state.
+     */
+    {
+        CList *iter, *tmp;
+
+        c_list_for_each_safe(iter, tmp, &priv->policy_auto_activate_lst_head) {
+            PolicyAutoActivateItem *item =
+                c_list_entry(iter, PolicyAutoActivateItem, lst);
+
+            c_list_unlink(&item->lst);
+            g_free(item);
+        }
+    }

     nm_assert(g_hash_table_size(priv->devices) == 0);

