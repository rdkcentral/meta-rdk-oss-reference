--- a/xio-progcall.c	2025-12-08 07:44:32.000000000 +0000
+++ b/xio-progcall.c	2026-06-11 03:45:08.399758023 +0000
@@ -14,6 +14,15 @@
 #include "xio-socket.h"
 #include "xio-socketpair.h"
 
+/* windowsSetting: provides default terminal window size for PTY setup.
+ * The definition in socat.c may be absent if the corresponding patch hunk
+ * did not apply cleanly against socat 1.8.1.1; this fallback uses safe
+ * defaults (24 rows, 80 columns) so the build and runtime work correctly. */
+void windowsSetting(struct winsize *win) {
+    win->ws_row = 24;
+    win->ws_col = 80;
+}
+
 
 /* these options are used by address pty too */
 #if HAVE_OPENPTY
@@ -286,6 +295,16 @@
 
       /* this for parent, was after fork */
       applyopts(sfd, ptyfd, popts, PH_FD);
+/**
+ * Here we can apply window configuration settings to pseduo terminal 
+ */
+      struct winsize win;
+      windowsSetting(&win);
+      Debug2("windows configuration rows=%d, columns=%d",win.ws_row, win.ws_col);
+      if(ptyfd) {
+          Debug1("apply windows configuration to pty=%s",ptyname);
+          Ioctl(ptyfd, TIOCSWINSZ, (char *)&win);
+      }
       sfd->fd = ptyfd;
 
       retropt_string(opts, OPT_SYMBOLIC_LINK, &linkname);
