From 0a742ec11db00fe2263a30da9cc05bff73e16691 Mon Sep 17 00:00:00 2001
Date: Thu, 29 Jun 2017 20:04:10 +0000
Subject: [PATCH] RDK-19472: Key handling for browser apps

Extend the evdev keycode range and define key symbols for the remote's
color keys.

Upstream-Status: Pending
Source: COMCAST
Signed-off-by: Azam Ayub Ansari <aansari@cable.comcast.com>
---
diff --git a/keycodes/evdev b/keycodes/evdev
--- a/keycodes/evdev
+++ b/keycodes/evdev
@@ -5 +5 @@ default xkb_keycodes "evdev" {
-	maximum = 255;
+	maximum = 512;
@@ -606,0 +607,4 @@ default xkb_keycodes "evdev" {
+	<Yellow> = 406;
+	<Blue>   = 407;
+	<Red>    = 408;
+	<Green>  = 409;
diff --git a/symbols/inet b/symbols/inet
--- a/symbols/inet
+++ b/symbols/inet
@@ -202,0 +203,4 @@ xkb_symbols "evdev" {
+    key <Yellow> {      [ XF86Yellow        ]       };
+    key <Blue>   {      [ XF86Blue          ]       };
+    key <Red>    {      [ XF86Red           ]       };
+    key <Green>  {      [ XF86Green         ]       };
