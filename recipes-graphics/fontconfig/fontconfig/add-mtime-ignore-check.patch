Add possibility to ignore cache mtime when looking up caches and validating them. This is useful for pre-created caches, which may have an mtime that doesn't match the directory's mtime.
Use the environment variable FONTCONFIG_IGNORE_CACHE_MODTIME to control this behavior. If set to a true value, cache mtimes will be ignored when looking up caches and validating them. If set to a false value or not set at all, cache mtimes will be used as normal.
Upstream-Status: Appropriate
Signed-off-by: Glib Novodran <gnovodran@productengine.com>
Index: b/src/fccache.c
===================================================================
--- a/src/fccache.c
+++ b/src/fccache.c
@@ -267,6 +267,32 @@
 
 }
 
+static FcBool
+FcCacheShouldIgnoreMtime (void)
+{
+    enum {
+      MTIME_CHECK_NOT_INITIALIZED = 0,
+      MTIME_CHECK_IGNORE,
+      MTIME_CHECK_VALIDATE,
+    } status;
+    static void *static_status;
+
+    status = (intptr_t) fc_atomic_ptr_get (&static_status);
+
+    if (status == MTIME_CHECK_NOT_INITIALIZED)
+    {
+	const char *env = getenv ("FONTCONFIG_IGNORE_CACHE_MODTIME");
+	FcBool ignore;
+	if (env && FcNameBool ((const FcChar8 *) env, &ignore))
+	    status = ignore ? MTIME_CHECK_IGNORE : MTIME_CHECK_VALIDATE;
+	else
+	    status = MTIME_CHECK_VALIDATE;
+	(void) fc_atomic_ptr_cmpexch (&static_status, NULL, (void *) status);
+    }
+
+    return status == MTIME_CHECK_IGNORE;
+}
