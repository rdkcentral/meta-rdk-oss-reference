+		continue;
 #ifdef HAVE_STRUCT_STAT_ST_MTIM
-	    if (s->cache_mtime_nano != cache_stat->st_mtim.tv_nsec)
+	    if (!ignore_mtime && s->cache_mtime_nano != cache_stat->st_mtim.tv_nsec)
 		continue;
 #endif
 	    FcRefInc (&s->ref);
 	    unlock_cache ();
 	    return s->cache;
 	}
+    }
     unlock_cache ();
     return NULL;
 }
