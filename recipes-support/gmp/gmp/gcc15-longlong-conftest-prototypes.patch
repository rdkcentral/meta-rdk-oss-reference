From: Build compatibility fix
Subject: [PATCH] Use prototypes in legacy long long compiler probes

GMP 4.2.1's compiler regression probes use implicit-int definitions and
undeclared helper calls. GCC 15 rejects those constructs before the probes
can test for the historical compiler bugs they target.

Upstream-Status: Pending

--- a/acinclude.m4
+++ b/acinclude.m4
@@ -594,10 +594,13 @@ GMP_PROG_CC_WORKS_PART([$1], [long long reliability test 1],
 #ifdef __GNUC__
 typedef unsigned long long t1;typedef t1*t2;
+static void h (void);
+static void g (int, t1 *, t1, t1 *, t1 *, int);
 __inline__ t1 e(t2 rp,t2 up,int n,t1 v0)
 {t1 c,x,r;int i;if(v0){c=1;for(i=1;i<n;i++){x=up[i];r=x+1;rp[i]=r;}}return c;}
-f(){static const struct{t1 n;t1 src[9];t1 want[9];}d[]={{1,{0},{1}},};t1 got[9];int i;
+static int f (void) {static const struct{t1 n;t1 src[9];t1 want[9];}d[]={{1,{0},{1}},};t1 got[9];int i;
 for(i=0;i<1;i++){if(e(got,got,9,d[i].n)==0)h();g(i,d[i].src,d[i].n,got,d[i].want,9);if(d[i].n)h();}}
-h(){}g(){}
+static void h (void) {}
+static void g (int i, t1 *src, t1 n, t1 *got, t1 *want, int size) {}
 #else
 int dummy;
 #endif
@@ -612,2 +615,3 @@
-f(int u){int i;long long x;x=u?~0:0;if(x)for(i=0;i<9;i++);x&=g();if(x)g();}
-g(){}
+static int g (void);
+static int f (int u) {int i;long long x;x=u?~0:0;if(x)for(i=0;i<9;i++);x&=g();if(x)g();}
+static int g (void) { return 0; }
-- 
End of patch
