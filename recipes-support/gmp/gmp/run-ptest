#!/bin/sh
# run-ptest script for GMP
# FINAL VERSION with diagnostics for missing test binaries

# Initialize counters
passed=0
failed=0

# Output function to format results
output() {
            if [ $? -eq 0 ]; then
                            echo "PASS: $test"
                                    passed=$((passed + 1))
                                        else
                                                        echo "FAIL: $test"
                                                                failed=$((failed + 1))
                                                                    fi
                                                            } 

                                                    # Get ptest directory
                                                    PTEST_PATH=$(dirname $(readlink -f $0))

                                                    # Check if tests directory exists
                                                    if [ ! -d "$PTEST_PATH/tests" ]; then
                                                                echo "ERROR: tests directory not found at $PTEST_PATH/tests"
                                                                    echo "FAIL: GMP ptest installation incomplete"
                                                                        exit 1
                                                    fi

                                                    # Change to tests directory
                                                    cd "$PTEST_PATH/tests"

                                                    # Check for test binaries in multiple locations
                                                    TEST_COUNT=0

                                                    # First check for t-* binaries in current directory
                                                    for test in t-* 2>/dev/null; do
                                                                if [ -f "$test" ] && [ -x "$test" ]; then
                                                                                TEST_COUNT=$((TEST_COUNT + 1))
                                                                                    fi
                                                                            done

                                                                            # If no tests found in tests/, check tests/.libs/
                                                                            if [ $TEST_COUNT -eq 0 ] && [ -d ".libs" ]; then
                                                                                        cd .libs
                                                                                            for test in t-* 2>/dev/null; do
                                                                                                            if [ -f "$test" ] && [ -x "$test" ]; then
                                                                                                                                TEST_COUNT=$((TEST_COUNT + 1))
                                                                                                                                        fi  
                                                                                                                                            done
                                                                            fi

                                                                            # If still no tests found, report error
                                                                            if [ $TEST_COUNT -eq 0 ]; then
                                                                                        echo "ERROR: No GMP test binaries found!"
                                                                                            echo "Checked locations:"
                                                                                                echo "  - $PTEST_PATH/tests/"
                                                                                                    echo "  - $PTEST_PATH/tests/.libs/"
                                                                                                        echo ""
                                                                                                            echo "Directory contents:"
                                                                                                                ls -la "$PTEST_PATH/tests/" 2>/dev/null || echo "  (tests/ directory empty or not readable)"
                                                                                                                    ls -la "$PTEST_PATH/tests/.libs/" 2>/dev/null || echo "  (.libs/ directory does not exist)"
                                                                                                                        echo ""
                                                                                                                            echo "This indicates the GMP ptest was not properly installed."
                                                                                                                                echo "Please rebuild GMP with the corrected bbappend file."
                                                                                                                                    echo "FAIL: No tests to run"
                                                                                                                                        exit 1
                                                                            fi

                                                                            echo "Found $TEST_COUNT GMP test binaries"
                                                                            echo ""

                                                                            # Run all test binaries
                                                                            for test in t-* 2>/dev/null; do
                                                                                        # Skip if not executable file
                                                                                            if [ ! -f "$test" ] || [ ! -x "$test" ]; then
                                                                                                            continue
                                                                                                                fi

                                                                                                                    # Run the test
                                                                                                                        ./$test
                                                                                                                            output
                                                                                                                    done

                                                                                                                    # Print summary
                                                                                                                    echo ""
                                                                                                                    echo "=== GMP Test Summary ==="
                                                                                                                    echo "PASSED: $passed"
                                                                                                                    echo "FAILED: $failed"
                                                                                                                    echo "TOTAL: $((passed + failed))"

                                                                                                                    # Return exit status
                                                                                                                    if [ $failed -gt 0 ]; then
                                                                                                                                exit 1
                                                                                                                        else
                                                                                                                                    exit 0
                                                                                                                    fi
