-	subscs	r2, r2, #8
-	stmiacs	r3!, {r1, ip}
-	subscs	r2, r2, #8
-	stmiacs	r3!, {r1, ip}
-	subscs	r2, r2, #8
-	stmiacs	r3!, {r1, ip}
-	bcs	1b
-
-	and	r2, r2, #7
-2:
-	subs	r2, r2, #1	@ store up to 4 bytes per loop iteration
-	strbcs	r1, [r3], #1
-	subscs	r2, r2, #1
-	strbcs	r1, [r3], #1
-	subscs	r2, r2, #1
-	strbcs	r1, [r3], #1
-	subscs	r2, r2, #1
-	strbcs	r1, [r3], #1
-	bcs	2b
+.L_done:
+    bx      lr                  @ Return original r0
 
-	DO_RET(lr)
 END(memset)
 libc_hidden_builtin_def (memset)
