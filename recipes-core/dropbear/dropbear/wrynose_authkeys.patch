From: nm296 <nareshkumar_m@comcast.com>
Subject: [PATCH] Patch dropbear to accept a custom authorized_keys file

Adds "-f <file>" so the server reads authorized keys from <file> inside the
authorized-keys directory instead of the fixed name "authorized_keys".

Rebased for dropbear 2025.89: the sources moved under src/, svr-authpubkey.c
already includes runopts.h, and both call sites now share the helper
authorized_keys_filepath(), so overriding the filename there covers the key
lookup and the permission check at once.

Signed-off-by: nm296 <nareshkumar_m@comcast.com>
Upstream-Status: Pending

diff -urN a/src/runopts.h b/src/runopts.h
--- a/src/runopts.h	2025-12-16 14:30:00.000000000 +0000
+++ b/src/runopts.h	2026-10-07 09:39:55.061683682 +0000
@@ -66,6 +66,7 @@
 typedef struct svr_runopts {
 
 	char * bannerfile;
+	char * auth_keys_file;
 
 	int forkbg;
 
diff -urN a/src/svr-authpubkey.c b/src/svr-authpubkey.c
--- a/src/svr-authpubkey.c	2025-12-16 14:30:00.000000000 +0000
+++ b/src/svr-authpubkey.c	2026-10-07 09:39:55.061683682 +0000
@@ -439,7 +439,8 @@
 static char *authorized_keys_filepath() {
 	size_t len = 0;
 	char *pathname = NULL, *dir = NULL;
-	const char *filename = "authorized_keys";
+	const char *filename = svr_opts.auth_keys_file ?
+				svr_opts.auth_keys_file : "authorized_keys";
 
 	dir = expand_homedir_path_home(svr_opts.authorized_keys_dir,
 				       ses.authstate.pw_dir);
diff -urN a/src/svr-runopts.c b/src/svr-runopts.c
--- a/src/svr-runopts.c	2025-12-16 14:30:00.000000000 +0000
+++ b/src/svr-runopts.c	2026-10-07 09:39:55.061683682 +0000
@@ -117,6 +117,8 @@
                                         "-A <authplugin>[,<options>]\n"
                                         "               Enable external public key auth through <authplugin>\n"
 #endif
+					"-f <file>  Read authorized keys from <file> instead of\n"
+					"           authorized_keys\n"
 					"-V    Version\n"
 #if DEBUG_TRACE
 					"-v    verbose (repeat for more verbose)\n"
@@ -158,6 +160,7 @@
 
 	/* see printhelp() for options */
 	svr_opts.bannerfile = NULL;
+	svr_opts.auth_keys_file = NULL;
 	svr_opts.banner = NULL;
 	svr_opts.forced_command = NULL;
 	svr_opts.forkbg = 1;
@@ -225,6 +228,9 @@
 				case 'c':
 					next = &svr_opts.forced_command;
 					break;
+				case 'f':
+					next = &svr_opts.auth_keys_file;
+					break;
 				case 'd':
 				case 'r':
 					next = &keyfile;
