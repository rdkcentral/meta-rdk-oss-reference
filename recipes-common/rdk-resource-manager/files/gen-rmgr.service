[Unit]
Description=Generic Resource Mgr
After=basic.target
Before=dsmgr.service audioserver.service ermgr.service
[Service]
Type=simple
Environment="XDG_RUNTIME_DIR=/tmp"
Environment="CONFIG_FILE_PATH=/etc/default/resources.conf"
ExecStart=/bin/bash -c "/usr/bin/ResourceManager/resourcemanager >> /opt/logs/wpeframework.log 2>&1 & /usr/bin/ResourceProvider/resourceprovider >> /opt/logs/sky-messages.log 2>&1 & wait"
Restart=always
[Install]
WantedBy=multi-user.target
