From: Yocto Wrynose migration
Subject: [PATCH] gst-plugins-good: support TagLib 2 frame API

TagLib 2 removed the TagLib::uint overload for creating ID3v2 frames and
requires the ID3v2 tag header instead. Use the header-based API for TagLib 2
while retaining compatibility with TagLib 1.

Upstream-Status: Pending

---
 ext/taglib/gstid3v2mux.cc | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/ext/taglib/gstid3v2mux.cc b/ext/taglib/gstid3v2mux.cc
--- a/ext/taglib/gstid3v2mux.cc
+++ b/ext/taglib/gstid3v2mux.cc
@@ -48,6 +48,8 @@
 #include <commentsframe.h>
 #include <unknownframe.h>
 #include <id3v2synchdata.h>
+#include <id3v2header.h>
+#include <taglib.h>
 #include <id3v2tag.h>
 #include <gst/tag/tag.h>
 
@@ -387,8 +389,15 @@ add_id3v2frame_tag (ID3v2::Tag * id3v2tag, const GstTagList * list,
         GST_DEBUG ("Injecting ID3v2.%u frame %u/%u of length %" G_GSIZE_FORMAT " and type %"
             GST_PTR_FORMAT, version, i, num_tags, map.size, s);
 
+#if TAGLIB_MAJOR_VERSION >= 2
+        ID3v2::Header header;
+        header.setMajorVersion (version);
+        frame = factory->createFrame (ByteVector ((const char *) map.data,
+                map.size), &header);
+#else
         frame = factory->createFrame (ByteVector ((const char *) map.data,
                 map.size), (TagLib::uint) version);
+#endif
         if (frame)
           id3v2tag->addFrame (frame);
 
@@ -581,7 +590,13 @@ add_url_tag (ID3v2::Tag * id3v2tag, const GstTagList * list,
 
       g_free (data);
 
+#if TAGLIB_MAJOR_VERSION >= 2
+      ID3v2::Header header;
+      header.setMajorVersion (4);
+      frame = factory->createFrame (bytes, &header);
+#else
       frame = factory->createFrame (bytes, (TagLib::uint) 4);
+#endif
       if (frame) {
         id3v2tag->addFrame (frame);
 
